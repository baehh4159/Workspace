{
  "expo": {
    "name": "Workspace",
    "slug": "universal-workspace",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "universal-workspace",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.universalworkspace.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "30초 빠른 음성 메모를 녹음하기 위해 마이크 권한이 필요합니다.",
        "NSCameraUsageDescription": "문서를 스캔하여 입력함에 저장하기 위해 카메라 권한이 필요합니다."
      }
    },
    "android": {
      "package": "com.universalworkspace.app",
      "permissions": ["RECORD_AUDIO", "CAMERA", "POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-av",
        {
          "microphonePermission": "30초 빠른 음성 메모를 녹음하기 위해 마이크 권한이 필요합니다."
        }
      ]
    ]
  }
}
