# Supabase Project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Origin (for OAuth callback redirect)
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Maintenance Cron Secret (Bearer token for POST /api/cron/maintenance)
CRON_SECRET=replace-with-long-random-secret

# Zero-Data-Retention AI Provider (matches packages/ai/worker.ts)
AI_PROVIDER_ENDPOINT=https://api.openai.com/v1
AI_PROVIDER_API_KEY=your-ai-api-key

# Optional: Webhook URL for 7-day and 1-day free-plan original expiry alerts (POST /api/cron/maintenance)
NOTIFICATION_WEBHOOK_URL=
