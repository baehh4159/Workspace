# Supabase Project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Origin (for OAuth callback redirect)
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Maintenance Cron Secret (Bearer token for POST /api/cron/maintenance)
CRON_SECRET=replace-with-long-random-secret

# AI provider: any OpenAI-compatible API (see packages/ai/worker.ts)
AI_PROVIDER_ENDPOINT=https://api.openai.com/v1
AI_PROVIDER_API_KEY=your-ai-api-key
# Optional: models (vision/text model must accept images and PDF file input)
AI_TEXT_MODEL=gpt-4o-mini
AI_TRANSCRIBE_MODEL=whisper-1
# Optional: request timeout and USD prices used only for the cost estimate in ai_usage_ledger
AI_TIMEOUT_MS=60000
AI_PRICE_INPUT_PER_MTOK=0
AI_PRICE_OUTPUT_PER_MTOK=0
AI_PRICE_TRANSCRIBE_PER_MIN=0

# Optional: Webhook URL for 7-day and 1-day free-plan original expiry alerts (POST /api/cron/maintenance)
NOTIFICATION_WEBHOOK_URL=
